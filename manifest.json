{
  "manifest_version": 3,
  "name": "MHTML Page Saver",
  "version": "1.0.0",
  "description": "現在表示中のWebページをMHTML形式で保存します",
  "permissions": [
    "activeTab",
    "downloads",
    "pageCapture",
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "ページをMHTMLで保存",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
